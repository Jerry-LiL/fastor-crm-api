{
  "info": {
    "_postman_id": "7f8b9e63-d124-4f90-a541-6927d3c90e2b",
    "name": "Fastor CRM API",
    "description": "REST API collection for Fastor CRM counselor and enquiry management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Counselor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Counselor\",\n  \"email\": \"jane.counselor@example.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login Counselor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    pm.environment.set('token', res.token);",
                  "    console.log('Saved token to collection variable: token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.counselor@example.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Enquiries",
      "item": [
        {
          "name": "Submit Public Enquiry (Unauthenticated)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Student\",\n  \"email\": \"alex.student@example.com\",\n  \"phone\": \"+14155552671\",\n  \"courseInterest\": \"Full Stack Web Development\",\n  \"message\": \"Interested in joining the upcoming weekend cohort.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/enquiries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "enquiries"]
            }
          },
          "response": []
        },
        {
          "name": "Get Public Unclaimed Enquiries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/enquiries/public?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "enquiries", "public"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Claim Enquiry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/enquiries/1/claim",
              "host": ["{{baseUrl}}"],
              "path": ["api", "enquiries", "1", "claim"]
            }
          },
          "response": []
        },
        {
          "name": "Get My Claimed Enquiries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/enquiries/mine",
              "host": ["{{baseUrl}}"],
              "path": ["api", "enquiries", "mine"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
